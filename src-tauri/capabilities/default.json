{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$DOCUMENT/card-maker-ims" },
        { "path": "$DOCUMENT/card-maker-ims/**" },
        { "path": "$DOCUMENT/yu-gi-oh-home/card-maker-ims" },
        { "path": "$DOCUMENT/yu-gi-oh-home/card-maker-ims/**" },
        { "path": "$APPDATA/card-maker-ims" },
        { "path": "$APPDATA/card-maker-ims/**" }
      ]
    }
  ]
}
