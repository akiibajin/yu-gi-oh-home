{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yu-gi-oh-home",
  "version": "6.0.0",
  "identifier": "com.julia.yu-gi-oh-home",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yu-gi-oh calc and maker",
        "width": 1280,
        "height": 1280
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMDcyQUJBMzNERjZCNjgKUldSb2E5OHp1aW9INHQwQWQySlBhK2ZaNFM1ZHdBWDczd2dGbERBMW1nOUhQQVJldWg5SnpsUVoK",
      "endpoints": [
        "https://github.com/akiibajin/yu-gi-oh-home/releases/latest/download/latest.json"
      ]
    }
  }
}
